# ============================================================================
#  Credenciales del proyecto. Copia este archivo a `.env` y rellena los valores.
#  El `.env` real está en .gitignore — NUNCA lo subas al repositorio.
#  Guía paso a paso para obtener cada credencial: docs/CREDENCIALES.md
# ============================================================================

# --- eBird API 2.0 (avistamientos puntuales) -------------------------------
# Obtener en: https://ebird.org/api/keygen  (inmediato, requiere cuenta eBird)
EBIRD_API_KEY=

# --- Xeno-canto API v3 (audio etiquetado) ----------------------------------
# Obtener en tu cuenta: https://xeno-canto.org/  ->  Account -> API
XENOCANTO_API_KEY=

# --- GBIF (descargas masivas: iNaturalist + eBird occurrences) -------------
# Cuenta gratuita en: https://www.gbif.org/user/profile
GBIF_USER=
GBIF_PWD=
GBIF_EMAIL=

# --- Copernicus Climate Data Store / ERA5 (clima) --------------------------
# Token personal en: https://cds.climate.copernicus.eu/  -> Your profile
# (cdsapi también lee de ~/.cdsapirc; ver docs/CREDENCIALES.md)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- Google Earth Engine (Sentinel-2 / NDVI) -------------------------------
# 1) Regístrate en https://earthengine.google.com/  (cuenta no comercial)
# 2) Crea/asocia un proyecto en Google Cloud y pon su ID aquí.
# 3) Autentícate una vez con:  uv run earthengine authenticate
EE_PROJECT=
# Opcional (modo headless / service account): ruta al JSON de credenciales
# GOOGLE_APPLICATION_CREDENTIALS=

# --- iNaturalist (opcional; solo para escritura / límites altos) -----------
# La lectura pública no requiere credenciales.
# INAT_APP_ID=
# INAT_APP_SECRET=
